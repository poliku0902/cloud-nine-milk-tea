# Copy this file to .env and adjust.

# Local development: start the bundled Postgres with `npm run db:dev -- --detach`
# and use the TCP connection string it prints (usually the one below).
# Production: your hosted Postgres URL (e.g. Neon), with ?sslmode=require.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Port the API listens on.
PORT=3001

# Frontend origin(s) allowed to call the API, comma-separated.
CLIENT_ORIGIN="http://localhost:5173"
