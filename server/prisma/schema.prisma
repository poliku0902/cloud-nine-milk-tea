// Cloud Nine database schema.
// Money is always stored as integer cents (650 = $6.50) to avoid floating-point rounding errors.
// Columns and tables use snake_case in Postgres; the Prisma client exposes them as camelCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  label     String
  sortOrder Int     @default(0) @map("sort_order")
  drinks    Drink[]

  @@map("categories")
}

model Drink {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  description String
  priceCents  Int      @map("price_cents")
  bestSeller  Boolean  @default(false) @map("best_seller")
  /// false = sold out / hidden from the public menu, without deleting it
  available   Boolean  @default(true)
  /// palette key for the SVG cup illustration shown when the photo fails to load
  color       String
  imageUrl    String?  @map("image_url")
  sortOrder   Int      @default(0) @map("sort_order")
  categoryId  Int      @map("category_id")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("drinks")
}

model Size {
  id         Int    @id @default(autoincrement())
  slug       String @unique
  label      String
  /// e.g. "16 oz"
  note       String
  /// added on top of the drink's base price
  extraCents Int    @default(0) @map("extra_cents")
  sortOrder  Int    @default(0) @map("sort_order")

  @@map("sizes")
}

model AddOn {
  id         Int     @id @default(autoincrement())
  slug       String  @unique
  name       String
  priceCents Int     @map("price_cents")
  available  Boolean @default(true)
  sortOrder  Int     @default(0) @map("sort_order")

  @@map("add_ons")
}
